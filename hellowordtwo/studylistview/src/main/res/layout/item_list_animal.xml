<?xml version="1.0" encoding="utf-8"?>
<!--
    ListView 中一项的布局。
    注意：ListView 的每一项都是一个真实的 View，所以这里必须是「自包含」的，
    根布局的高度用 wrap_content（用 match_parent 会导致只显示一项）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/img_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_icon_dog" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_aName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/item_title"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="狗说" />

        <TextView
            android:id="@+id/txt_aSpeak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/item_subtitle"
            android:textSize="14sp"
            tools:text="你是狗么?" />

    </LinearLayout>

</LinearLayout>
