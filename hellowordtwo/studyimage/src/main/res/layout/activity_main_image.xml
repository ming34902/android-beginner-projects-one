<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/studyImage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".MainActivityImage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/image1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="30dp"
            android:src="@drawable/sponge_1"
            android:background="#FF4455" />

        <ImageView
            android:id="@+id/image2"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:alpha="0.5"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/sponge_2" />

        <ImageView
            android:id="@+id/image3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="#ff9900"
            android:src="@drawable/woman_1" />

        <ImageView
            android:id="@+id/image4"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="#DDA0DD"
            android:src="@drawable/woman_2" />

        <ImageView
            android:id="@+id/image5"
            android:layout_width="200dp"
            android:layout_height="400dp"
            android:adjustViewBounds="true"
            android:scaleType="center"
            android:background="#7B68EE"
            android:src="@drawable/cat_1" />

        <ImageView
            android:id="@+id/image6"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="#00FF00"
            android:src="@drawable/cloud_1" />
    </LinearLayout>

</ScrollView>
